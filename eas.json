{
  "cli": {
    "version": ">= 13.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "SUPABASE_URL": "https://devprojectref000000x.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_DEV_KEY_REDACTED",
        "SUPERWALL_API_KEY": "pk_SUPERWALL_KEY_REDACTED",
        "SKIP_PAYWALL": "false",
        "SHOW_DEMO_BUTTON": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "SUPABASE_URL": "https://devprojectref000000x.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_DEV_KEY_REDACTED",
        "SUPERWALL_API_KEY": "pk_SUPERWALL_KEY_REDACTED",
        "SKIP_PAYWALL": "false",
        "SHOW_DEMO_BUTTON": "true"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "SUPABASE_URL": "https://prodprojectref00000x.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_PROD_KEY_REDACTED",
        "SUPERWALL_API_KEY": "pk_SUPERWALL_KEY_REDACTED",
        "SKIP_PAYWALL": "false"
      }
    }
  }
}
