{
  "expo": {
    "name": "Kinderwell",
    "slug": "kinderwell",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "_comment": "Cream (OnboardingColors.paper). Was #4F8F8B teal, which is the pre-2026-09 brand: iOS paints this BEFORE React starts, so every cold launch flashed teal and then jumped to a cream app.",
      "backgroundColor": "#eee9dc"
    },
    "icon": "./assets/icon.png",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#4F8F8B"
    },
    "ios": {
      "buildNumber": "12"
    },
    "android": {
      "versionCode": 1,
      "permissions": [
        "android.permission.NOTIFICATIONS"
      ]
    },
    "scheme": "kinderwell",
    "plugins": [
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/newsreader/300Light/Newsreader_300Light.ttf",
            "./node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
            "./node_modules/@expo-google-fonts/newsreader/400Regular_Italic/Newsreader_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-mono/400Regular/IBMPlexMono_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-mono/500Medium/IBMPlexMono_500Medium.ttf"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "privacy": "public",
    "extra": {
      "eas": {
        "projectId": "EAS-PROJECT-ID-REDACTED"
      }
    }
  }
}
